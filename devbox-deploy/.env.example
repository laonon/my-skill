# 复制为 .env 后填真实值（.env 权限 600，别提交）

# SSH 兜底通道（dbx 使用）
DEVBOX_HOST=10.33.207.254
DEVBOX_USER=guanfu
DEVBOX_PASS=请填入密码

# 部署控制台 API（dvctl 使用）
CONSOLE_URL=https://guide.realsee.cn/apps/console

# 令牌：推荐用自己的访问令牌 —— 控制台「设置 → 脚本令牌 → 生成」，
# 然后 `dvctl login --token <令牌>`（会自动写回这里）。
# 用个人令牌时，发布的应用自动归自己，权限也按人算。
CONSOLE_TOKEN=

# 兜底：继续用共享管理员令牌时，用它声明归属（不填则记成内置管理员 admin）
CONSOLE_OWNER=
CONSOLE_OWNER_NAME=
