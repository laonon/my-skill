# 复制为 .env 后填真实值（.env 权限 600，别提交）

# SSH 兜底通道（dbx 使用，可选 —— 只有 dvctl 不通时才需要）
DEVBOX_HOST=10.33.207.254
DEVBOX_USER=guanfu
DEVBOX_PASS=请填入密码

# 部署控制台 API（dvctl 使用）
CONSOLE_URL=https://guide.realsee.cn/apps/console

# 你的个人令牌 —— 唯一身份，登录和发布都用它。
# 怎么拿：用如视账号（手机号）登录控制台，首次进入会自动发放并显示一次；
#        然后执行 `dvctl login --token <令牌>`，会自动写回这里。
# 用它发布的应用自动归你名下，权限按人计算。共享管理员令牌已下线，不要再找管理员要 key。
CONSOLE_TOKEN=

# 可选：管理员显式指定「这次发布算谁的」（成员填了无效，日常不需要）。
# 转移归属请用控制台应用编辑弹窗里的「归属人 ID」。
CONSOLE_OWNER=
CONSOLE_OWNER_NAME=
