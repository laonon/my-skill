#!/usr/bin/env bash
# 构建并同步 /Users/mmk/Gitlab/realsee-dev 到开发机 /solutions/
# 用法：deploy-realsee-dev [项目路径]
set -euo pipefail

PROJECT="${1:-/Users/mmk/Gitlab/realsee-dev}"
BASE_PATH="/solutions/"
HERE="$(cd "$(dirname "$0")" && pwd)"
DBX="$HERE/dbx"
REMOTE_DIR="/opt/apps/guide/solutions"
HOST="guide.realsee.cn"

STAMP="$(date +%Y%m%d-%H%M%S)"
TARBALL="/tmp/realsee-dev-${STAMP}.tgz"
NAME="$(basename "$TARBALL")"

if [ ! -d "$PROJECT" ]; then
  echo "✗ 项目目录不存在：$PROJECT"
  exit 1
fi

echo "▸ 项目   $PROJECT"
echo "▸ 目标   https://${HOST}${BASE_PATH}"
echo

# 1. 构建（必须带 base，否则资源路径会指向根目录）
echo "▸ 构建（BLUEBOOK_BASE=${BASE_PATH}）"
cd "$PROJECT"
BLUEBOOK_BASE="$BASE_PATH" npm run build

if [ ! -f "$PROJECT/dist/index.html" ]; then
  echo "✗ 构建产物缺少 dist/index.html"
  exit 1
fi

# 2. 打包（排除 macOS 垃圾文件）
echo
echo "▸ 打包"
COPYFILE_DISABLE=1 tar --no-xattrs -czf "$TARBALL" -C "$PROJECT/dist" .
echo "  $(du -h "$TARBALL" | cut -f1)  $(find "$PROJECT/dist" -type f | wc -l | tr -d ' ') 个文件"

# 3. 上传
echo
echo "▸ 上传"
"$DBX" put "$TARBALL" /tmp/ >/dev/null

# 4. 远程原子替换：先解压到暂存目录，校验通过再切换
echo
echo "▸ 在开发机上替换"
"$DBX" root "set -e
T=/tmp/${NAME}
STAGE=\$(mktemp -d /tmp/rd-stage-XXXXXX)
tar xzf \$T -C \$STAGE
find \$STAGE -name '._*' -delete
find \$STAGE -name '.DS_Store' -delete

# 解压失败 / 缺首页就不动线上
test -f \$STAGE/index.html || { echo '  ✗ 产物缺少 index.html，已中止'; rm -rf \$STAGE \$T; exit 1; }

chown -R guanfu:guanfu \$STAGE
find \$STAGE -type d -exec chmod 755 {} \\;
find \$STAGE -type f -exec chmod 644 {} \\;

BK=/opt/apps/_shared/backups
mkdir -p \$BK
if [ -d ${REMOTE_DIR} ]; then mv ${REMOTE_DIR} \$BK/solutions.\$(date +%s); fi
mv \$STAGE ${REMOTE_DIR}
rm -f \$T
# 只保留最近一份回滚备份（放在站点根之外，不可通过 web 访问）
ls -dt \$BK/solutions.* 2>/dev/null | tail -n +2 | xargs -r rm -rf
echo '  文件数: '\$(find ${REMOTE_DIR} -type f | wc -l)" 2>&1 | grep -vE 'password:|密码'

# 5. 验证
echo
echo "▸ 验证"
fail=0
check() {
  local path="$1" label="$2"
  local code
  code="$(curl -s -m 10 -o /dev/null -w '%{http_code}' "https://${HOST}${BASE_PATH}${path}")"
  printf "  %-28s %s\n" "$label" "$code"
  [ "$code" = "200" ] || fail=1
}
check "" "首页"
check "capabilities/" "能力展示"
check "delivery/" "交付方案"
check "usage-guide/" "使用指南"
check "assets/styles.css" "样式文件"
check "search-index.json" "搜索索引"

rm -f "$TARBALL"

if [ "$fail" -ne 0 ]; then
  echo
  echo "✗ 有页面未返回 200。回滚："
  echo "  dbx root \"ls -dt /opt/apps/_shared/backups/solutions.* | head -1 | xargs -I{} mv {} ${REMOTE_DIR}\""
  exit 1
fi

echo
echo "✓ 已更新：https://${HOST}${BASE_PATH}"
echo "  浏览器强刷（Cmd+Shift+R）可绕过本地缓存"
